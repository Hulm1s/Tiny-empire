# Unity YAML assets are text and must stay text, so diffs and merges are readable.
*.unity     text eol=lf
*.asset     text eol=lf
*.prefab    text eol=lf
*.mat       text eol=lf
*.meta      text eol=lf
*.controller text eol=lf
*.anim      text eol=lf

*.cs        text eol=lf diff=csharp
*.shader    text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.webmanifest text eol=lf

# Built Web player payloads: binary, never diff them.
*.unityweb  binary
*.wasm      binary
*.data      binary
*.png       binary
*.jpg       binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.mp3       binary
*.ogg       binary
*.wav       binary
